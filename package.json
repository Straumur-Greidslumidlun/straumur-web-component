{
  "name": "straumur-web-component",
  "version": "2.0.0",
  "license": "MIT",
  "homepage": "https://docs.straumur.is",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/index.mjs",
    "default": "./dist/index.js"
  },
  "description": "",
  "keywords": [
    "straumur",
    "checkout",
    "payment",
    "payments",
    "components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Straumur-Greidslumidlun/straumur-web-component.git"
  },
  "bugs": {
    "url": "https://github.com/Straumur-Greidslumidlun/straumur-web-component/issues"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@adyen/adyen-web": "6.25.0",
    "preact": "~10.28.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.4",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.7"
  }
}
